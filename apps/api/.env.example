PORT=4000
FRONTEND_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_SECRET=replace-with-a-long-random-secret
# Optional Web Push; generate using docs/ORDER_NOTIFICATIONS.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_ENCRYPTION_KEY=
PAYMENT_UPI_ID=
DATABASE_URL=postgresql://vks_app:replace-with-app-database-password@127.0.0.1:5432/vksveltraders
DATABASE_SCHEMA=vks
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=vks-images
S3_ACCESS_KEY_ID=GKreplace-with-32-hex-characters
S3_SECRET_ACCESS_KEY=replace-with-64-hex-characters
S3_FORCE_PATH_STYLE=true

# Combined Dokploy stack (Compose 2.23.1+). Replace all placeholders.
# Use independent random hex values; keep actual secrets out of Git.
POSTGRES_PASSWORD=replace-with-random-hex-password
APP_DATABASE_PASSWORD=replace-with-a-different-random-hex-password
GARAGE_RPC_SECRET=replace-with-64-hex-characters
GARAGE_ACCESS_KEY=GKreplace-with-32-hex-characters
GARAGE_SECRET_KEY=replace-with-64-hex-characters
# Set FRONTEND_URL above to https://vksveltraders.techlyai.in for Dokploy.
# Pin a tested frontend commit for reproducible deployments if desired.
FRONTEND_REF=main
